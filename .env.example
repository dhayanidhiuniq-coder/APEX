# ============================================================
# APEX environment variables
# ============================================================
# Copy to `.env.local` (frontend) or `.env` (backend) and fill in.
# NEVER commit real credentials. Only `.env.example` is tracked.
#
# Local URLs often appear in browser JavaScript and in URLs, so treat them as
# non-secret. Supabase's anon key is also not a secret: it is protected by
# Row Level Security on the Supabase side. What must NEVER reach the browser
# is the service-role key or the JWT secret.
# ============================================================


# ------------------------------------------------------------
# Frontend (Next.js) — PUBLIC values, embedded into the browser bundle
# ------------------------------------------------------------
# Only these three may be prefixed NEXT_PUBLIC_. Never put a secret in one.

# Supabase project URL. Dashboard -> Project Settings -> API.
# Find this under "Project URL" and the "API Keys" section.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Same page as the URL above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the APEX backend, used for server-side requests from Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000


# ------------------------------------------------------------
# Backend (FastAPI) — SERVER ONLY, never exposed to the browser
# ------------------------------------------------------------
# Comma-separated list of browser origins allowed by CORS.
# Add your production frontend origin here; no domain is hard-coded.
CORS_ORIGINS=http://localhost:3000

# Supabase values used to VERIFY incoming access tokens.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# OPTIONAL. When set, tokens are verified locally instead of via a network
# call to Supabase Auth. Leave EMPTY for hosted Supabase projects, which sign
# tokens with asymmetric keys that this project cannot verify offline.
# Only set this if you are running Supabase locally (self-hosted).
# SUPABASE_JWT_SECRET=

# Uvicorn bind settings (optional).
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true
