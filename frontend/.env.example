# Frontend (Next.js) — public values only.
# These are embedded into the browser bundle. The anon key is not a secret;
# it is protected by Supabase Row Level Security.
# NEVER put a service-role key or JWT secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the APEX backend, used for server-side requests from Next.js.
NEXT_PUBLIC_API_URL=http://localhost:8000
